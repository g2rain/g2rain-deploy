# G2Rain部署环境变量配置示例
# 复制此文件为 .env 并修改相应配置
SPRING_PROFILES_ACTIVE=test
PLATFORM_HOST=your.server.host
PLATFORM_PORT=10443
# 平台完整访问地址（固定 https 协议）
PLATFORM_BASE_URL=https://${PLATFORM_HOST}:${PLATFORM_PORT}
# IAM 对外根地址（与 g2rain-iam 中 IAM_BASE_URL 一致）；可与上项相同。不设置时 compose 内会回退为 PLATFORM_BASE_URL。
HEALTH_APP_IMAGE=g2rain/g2rain-health-app:latest

# MySQL配置
MYSQL_ROOT_PASSWORD=g2rain123456
MYSQL_DATABASE=g2rain
MYSQL_USER=g2rain
MYSQL_PASSWORD=g2rain123456
MYSQL_PORT=3306

# Redis配置
REDIS_PORT=6379
REDIS_PASSWORD=g2rain_redis_11050826

# 知识库业务片段 business.d/g2rain-knowledge.yml（Docling / Milvus / g2rain-knowledge / g2rain-knowledge-app）
# Docling / Milvus 默认映射宿主机端口供运维联调，生产须限制来源；Milvus 须保持鉴权。
# MILVUS_TOKEN 生产环境必须由受控 Secret 注入。
KNOWLEDGE_IMAGE=g2rain/g2rain-knowledge:latest
KNOWLEDGE_APP_IMAGE=g2rain/g2rain-knowledge-app:latest
KNOWLEDGE_STORAGE_ROOT=/data/knowledge
# 派生镜像，基础为 ghcr.io/docling-project/docling-serve-cpu:v1.29.0。部署前需 build。
# 若这里仍写官方 ghcr 标签，Compose 会跳过 OpenCV 修复。
DOCLING_IMAGE=g2rain/docling-serve-cpu:v1.29.0
DOCLING_BASE_URL=http://docling-serve:5001
DOCLING_PORT=5001
# HybridChunker tokenizer（all-MiniLM-L6-v2）HF cache。默认挂宿主机 huggingface 目录（需先 download MiniLM）。
# 也可用独立目录：DOCLING_HF_CACHE=./data/docling-hf（须自行拷入 hub/models--sentence-transformers--all-MiniLM-L6-v2）
DOCLING_HF_CACHE=/root/.cache/huggingface
# 无出网默认 1；首次若需容器内从镜像拉模型可临时改为 0
DOCLING_HF_HUB_OFFLINE=1
DOCLING_TRANSFORMERS_OFFLINE=1
DOCLING_HF_ENDPOINT=https://hf-mirror.com
MILVUS_IMAGE=milvusdb/milvus:v3.0.2
MILVUS_URI=http://milvus:19530
MILVUS_PORT=19530
# 知识库服务账号。Compose 不创建该账号，首次部署后由运维建立并替换密码。
MILVUS_TOKEN=knowledge-service:replace-with-secret
# 仅用于启动时检查并创建 collection 的管理员凭据，默认是 Milvus 初始 root。改密后必须同步，否则容器无法通过健康检查。
MILVUS_BOOTSTRAP_TOKEN=root:Milvus
KNOWLEDGE_MILVUS_COLLECTION=g2rain_knowledge_chunks_qwen_4096_v1
# 向量化、问答、重排的完整 URL 与模型名写在 Nacos Data ID g2rain-knowledge.yml，不从这里注入。

# Nginx配置
NGINX_HTTPS_PORT=10443

#NACOS配置
# 容器内访问 Nacos 须使用 Compose「服务名」nacos，与 container_name 无关
NACOS_SERVER_ADDR=nacos:8848
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_AUTH_TOKEN=VGhyZWVGb3J0eVR3b0J5dGVzU2VjcmV0S2V5Rm9yTmFjb3M=
NACOS_AUTH_IDENTITY_KEY=nacos
NACOS_AUTH_IDENTITY_VALUE=g2rain_nacos
NACOS_NAMESPACE=g2rain-test

# NACOS独立数据库配置
# 默认连本 compose 的 mysql 服务名；外置库时在服务器 .env 改为内网 IP/主机名（勿提交真实地址）
MYSQL_SERVICE_HOST=mysql
NACOS_DATABASE=nacos
NACOS_MYSQL_USER=nacos
NACOS_MYSQL_PASSWORD=g2rain_nacos

# 时区设置
TZ=Asia/Shanghai

# chat-shell 默认匿名接入码（manager-app「应用授权 → 匿名接入码」中创建后复制）；为空表示不开放匿名访问
CHAT_ANONYMOUS_ENTRY_KEY=
